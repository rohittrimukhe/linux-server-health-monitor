# Linux Server Health Monitor Enterprise - launcher
# Finds a Python 3.6+ interpreter (RHEL/OL 7 ship python3.6) and starts the app.
set -e
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
APP_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

find_python() {
  if [ -n "${LSHME_PYTHON:-}" ]; then echo "$LSHME_PYTHON"; return; fi
  for p in python3 python3.12 python3.11 python3.9 python3.8 python3.6 /usr/libexec/platform-python; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3,6) else 1)' 2>/dev/null; then
      command -v "$p"; return
    fi
  done
}
PY="$(find_python)"
if [ -z "$PY" ]; then
  echo "LSHME needs Python 3.6 or newer (RHEL/OL 7: yum install python3; 8/9: dnf install python3)." >&2
  exit 2
fi
export PYTHONPATH="$APP_DIR${PYTHONPATH:+:$PYTHONPATH}"
export PYTHONDONTWRITEBYTECODE=1
export PYTHONIOENCODING="${PYTHONIOENCODING:-utf-8:replace}"
exec "$PY" -m lshme --app-dir "$APP_DIR" "$@"
